OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# chat persistence -- sign up on cloud.assistant-ui.com
# NEXT_PUBLIC_ASSISTANT_BASE_URL=

# Shared state (Neon). Without it the app runs on in-memory seed data.
DATABASE_URL=
# Fly Machines: one machine per negotiation (FLY_APP_NAME/FLY_IMAGE_REF are set on Fly)
FLY_API_TOKEN=
# Who the agents call, per policy: {"auto-northstar":[{"phone":"+14155550100","name":"Anders","insurer":"Northstar Mutual"}]}
CALL_TARGETS=

# Voice (GPT-Live). Optional overrides:
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=marin
# Phone mode: sip (GPT-Live outbound SIP, needs org enablement) | twilio (Twilio dials, bridges to OpenAI SIP, webhook accepts). Auto-detected if unset.
VOICE_PHONE_MODE=
# Outbound SIP trunk (e.g. Twilio Elastic SIP trunk with TLS + SRTP + Opus)
SIP_PROVIDER_URL=
SIP_USERNAME=
SIP_PASSWORD=
SIP_CALLER_NUMBER=
# Twilio fallback + inbound SIP webhook (point project webhook live.transport.incoming at /api/live/webhook)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=
# Listen-in: let /api/live/listen attach its own sideband when the call runs on another machine (multi-attach unverified)
VOICE_LISTEN_ATTACH=

# Models: Neon AI Gateway (preferred, OpenAI-compatible; base URL without or with /v1) or OpenAI fallback
NEON_AI_GATEWAY_URL=
NEON_AI_GATEWAY_KEY=
STRATEGIST_MODEL=gpt-5-4-mini
FAST_MODEL=claude-haiku-4-5
CHAT_MODEL=
OPENAI_MODEL=gpt-5-mini
OPENAI_FAST_MODEL=
STRATEGIST_TIMEOUT_MS=1800
STRATEGIST_TEMPLATES=

# Research
EXA_API_KEY=
KERNEL_API_KEY=
PUBLIC_URL=

# Email (AgentMail)
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=
BROKER_EMAIL=
BROKER_EMAILS=
